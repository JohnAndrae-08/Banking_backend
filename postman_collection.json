{
  "info": {
    "name": "Banking System Backend",
    "description": "Educational Banking System API - execute requests in folder order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "accountId1", "value": "" },
    { "key": "accountId2", "value": "" },
    { "key": "accountNumber1", "value": "" },
    { "key": "accountNumber2", "value": "" },
    { "key": "transactionId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Smith\",\n  \"phone\": \"+1-555-0100\",\n  \"address\": \"123 Main St\"\n}"
        }
      }
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usernameOrEmail\": \"alice\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "3. Get my profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/customers/me",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "4. Create account 1 (SAVINGS)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/accounts",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"accountType\": \"SAVINGS\"\n}" }
      }
    },
    {
      "name": "5. Create account 2 (CHECKING)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/accounts",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"accountType\": \"CHECKING\"\n}" }
      }
    },
    {
      "name": "6. Deposit into account 1",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/accounts/{{accountId1}}/deposit",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 1000.00,\n  \"description\": \"Initial deposit\"\n}" }
      }
    },
    {
      "name": "7. Check balance",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/accounts/{{accountId1}}/balance",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "8. Transfer 1 -> 2",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/transfers",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceAccountNumber\": \"{{accountNumber1}}\",\n  \"destinationAccountNumber\": \"{{accountNumber2}}\",\n  \"amount\": 250.00,\n  \"description\": \"Rent split\"\n}"
        }
      }
    },
    {
      "name": "9. Withdraw from account 2",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/accounts/{{accountId2}}/withdraw",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 50.00,\n  \"description\": \"ATM withdrawal\"\n}" }
      }
    },
    {
      "name": "10. Transaction history account 1",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/accounts/{{accountId1}}/transactions?page=0&size=20",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "11. Get transaction by id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/transactions/{{transactionId}}",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    }
  ]
}
